#!/bin/bash
set -euxo pipefail
exec > /var/log/user-data.log 2>&1

# Atualiza sistema
apt update && apt upgrade -y

# Instala dependências
apt install -y \
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    default-mysql-client

# Instala Docker
curl -fsSL https://get.docker.com -o get-docker.sh
sh get-docker.sh

# Habilita Docker
systemctl enable docker
systemctl start docker

# Instala Docker Compose plugin
apt install -y docker-compose-plugin

# Cria diretório da aplicação
mkdir -p /app

# Escreve docker-compose
cat << 'EOF_COMPOSE' > /app/docker-compose.yml
${compose_backend}
EOF_COMPOSE

chmod 644 /app/docker-compose.yml

# Aguarda Docker estar pronto
echo "⏳ Aguardando Docker..."
timeout 60 bash -c 'until docker info > /dev/null 2>&1; do sleep 2; done'
echo "✅ Docker pronto"

# Faz pull das imagens
docker compose -f /app/docker-compose.yml pull || true

# Sobe containers
docker compose -f /app/docker-compose.yml up -d --remove-orphans

# Aguarda containers ficarem healthy
echo "⏳ Aguardando containers ficarem healthy..."
timeout 300 bash -c '
  until [ "$(docker inspect --format="{{.State.Health.Status}}" backend 2>/dev/null)" = "healthy" ]; do
    echo "Aguardando backend... $(date)"
    sleep 10
  done
'
echo "✅ Backend healthy!"

# Status final
docker ps -a
docker compose -f /app/docker-compose.yml logs --tail=50