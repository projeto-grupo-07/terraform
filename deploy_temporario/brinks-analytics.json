          "format": "table",
          "rawSql": "SELECT CONCAT( ELT(MONTH(v.data_hora), 'Janeiro','Fevereiro','Mar\u00e7o','Abril','Maio','Junho', 'Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'), '/', YEAR(v.data_hora) ) AS mes_ano, ROUND(SUM(iv.valor_total_venda_produto) - SUM(iv.quantidade_venda_produto * p.preco_custo), 2) AS lucro FROM itens_venda iv JOIN venda v ON iv.fk_venda = v.id JOIN produto p ON iv.fk_produto = p.id WHERE YEAR(v.data_hora) = YEAR(CURDATE()) GROUP BY YEAR(v.data_hora), MONTH(v.data_hora), CONCAT( ELT(MONTH(v.data_hora), 'Janeiro','Fevereiro','Mar\u00e7o','Abril','Maio','Junho', 'Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'), '/', YEAR(v.data_hora) ) ORDER BY YEAR(v.data_hora), MONTH(v.data_hora);",
