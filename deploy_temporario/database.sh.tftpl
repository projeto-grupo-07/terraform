#!/bin/bash
set -euxo pipefail

# Escreve o SQL de inicialização
cat << 'EOF_SQL' > /app/sql/init.sql
SET NAMES utf8mb4;
SET CHARACTER SET utf8mb4;
${init_sql_content}
EOF_SQL

# Escreve o docker-compose fornecido no repositório para /app/docker-compose.yml
cat << 'EOF_COMPOSE' > /app/docker-compose.yml
${compose_backend}
EOF_COMPOSE

# Puxa imagens e sobe o compose (compose vindo do repositório)
sudo docker compose -f /app/docker-compose.yml pull || true
sudo docker compose -f /app/docker-compose.yml up -d --remove-orphans