#!/bin/bash
set -euxo pipefail

curl -fsSL https://get.docker.com -o get-docker.sh
cat << 'EOF_COMPOSE' > /app/docker-compose-app.yml
version: "3.8"
services:
  backend:
    image: guilhermefigueiredodocker/brinks-backend-prod:latest
    ports:
      - "8080:8080"
    environment:
      SPRING_PROFILES_ACTIVE: prod
      JAVA_OPTS: "-Xmx512m -Xms256m"
      SPRING_DATASOURCE_URL: "jdbc:mysql://${db_host}:3306/db_brink_calcados?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
      SPRING_DATASOURCE_USERNAME: "$${SPRING_DATASOURCE_USERNAME:-appuser}"
      SPRING_DATASOURCE_PASSWORD: "$${SPRING_DATASOURCE_PASSWORD:-app123}"
      JWT_SECRET: "$${JWT_SECRET:-brink-calcados-super-secret-key-com-32-caracteres-ou-mais-2026}"
      SPRING_RABBITMQ_HOST: ${db_host}
      SPRING_RABBITMQ_PORT: 5672
      SPRING_RABBITMQ_USERNAME: "$${SPRING_RABBITMQ_USERNAME:-admin}"
      SPRING_RABBITMQ_PASSWORD: "$${SPRING_RABBITMQ_PASSWORD:-admin}"
    restart: unless-stopped

  ms-report-async:
    image: guilhermefigueiredodocker/brinks-ms-report
    environment:
      SPRING_RABBITMQ_HOST: ${db_host}
      SPRING_RABBITMQ_PORT: 5672
      SPRING_RABBITMQ_USERNAME: "$${SPRING_RABBITMQ_USERNAME:-admin}"
      SPRING_RABBITMQ_PASSWORD: "$${SPRING_RABBITMQ_PASSWORD:-admin}"
      AWS_REGION: us-east-1
    restart: unless-stopped

  ms-email:
    image: guilhermefigueiredodocker/brinks-ms-email
    environment:
      SPRING_RABBITMQ_HOST: ${db_host}
      SPRING_RABBITMQ_PORT: 5672
      SPRING_RABBITMQ_USERNAME: "$${SPRING_RABBITMQ_USERNAME:-admin}"
      SPRING_RABBITMQ_PASSWORD: "$${SPRING_RABBITMQ_PASSWORD:-admin}"
    restart: unless-stopped
EOF_COMPOSE

# Puxa imagens e sobe o compose de aplicação (conecta ao DB externo)
sudo docker compose -f /app/docker-compose-app.yml pull || true
sudo docker compose -f /app/docker-compose-app.yml up -d --remove-orphans
      SPRING_RABBITMQ_HOST: ${db_host}
      SPRING_RABBITMQ_PORT: 5672
      SPRING_RABBITMQ_USERNAME: admin
      SPRING_RABBITMQ_PASSWORD: admin
    restart: unless-stopped
EOF

sudo docker compose up -d