#!/bin/bash
set -euxo pipefail

# Instalação do Docker (Script oficial)
curl -fsSL https://get.docker.com -o get-docker.sh
sudo sh get-docker.sh
sudo systemctl enable docker
sudo systemctl start docker

# 1. Criamos a configuração que o seu Nginx interno vai usar
mkdir -p /app/nginx
cat << 'EOF' > /app/nginx/default.conf
server {
    listen 80;
    charset utf-8;

    # Entrega os arquivos estáticos do seu React (que já estão na imagem)
    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # PROXY REVERSO: Envia as chamadas /api para o Load Balancer
    location /api/ {
        proxy_pass http://${alb_dns}/; 
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
EOF

# 2. Escreve o docker-compose do repositório e usa ele
cat << 'EOF_COMPOSE' > /app/docker-compose.yml
${compose_frontend}
EOF_COMPOSE

sudo docker compose -f /app/docker-compose.yml pull || true
sudo docker compose -f /app/docker-compose.yml up -d --remove-orphans