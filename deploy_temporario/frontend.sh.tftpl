#!/bin/bash
echo "$(date '+%Y-%m-%d %H:%M:%S') [frontend] Iniciando script de provisionamento"

echo "$(date '+%Y-%m-%d %H:%M:%S') [frontend] Atualizando pacotes..."
sudo apt update && sudo apt upgrade -y

echo "$(date '+%Y-%m-%d %H:%M:%S') [frontend] Instalando dependências..."
sudo apt-get install -y docker.io docker-compose wget unzip curl python3

# ============================================================
# AWS CLI v2
# ============================================================
echo "$(date '+%Y-%m-%d %H:%M:%S') [awscli] Instalando AWS CLI v2..."
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -o /tmp/awscliv2.zip -d /tmp
sudo /tmp/aws/install --update
echo "$(date '+%Y-%m-%d %H:%M:%S') [awscli] AWS CLI instalado: $(aws --version)"

# ============================================================
# HOSTNAME COM NOME DA TAG (IMDSv2)
# ============================================================
echo "$(date '+%Y-%m-%d %H:%M:%S') [hostname] Definindo hostname com nome da tag..."
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)
INSTANCE_NAME=$(aws ec2 describe-instances \
  --instance-ids $INSTANCE_ID \
  --region us-east-1 \
  --query 'Reservations[0].Instances[0].Tags[?Key==`Name`].Value' \
  --output text)
if [ -n "$INSTANCE_NAME" ]; then
  sudo hostnamectl set-hostname $INSTANCE_NAME
  echo "$(date '+%Y-%m-%d %H:%M:%S') [hostname] Hostname definido como: $INSTANCE_NAME"
else
  echo "$(date '+%Y-%m-%d %H:%M:%S') [hostname] AVISO: Nome da tag não encontrado"
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') [frontend] Iniciando e habilitando serviço Docker..."
sudo systemctl start docker
sudo systemctl enable docker
sudo usermod -aG docker ubuntu

PROJECT_DIR="/home/ubuntu/app"
mkdir -p $PROJECT_DIR
cd $PROJECT_DIR

cat << 'EOF_COMPOSE' > $PROJECT_DIR/docker-compose.yml
${compose_frontend}
EOF_COMPOSE

cat <<EOF > $PROJECT_DIR/nginx.conf
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files \$uri /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_pass http://${lb_dns_name}/;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    }

    location /lambda/ {
        proxy_pass ${api_gateway_url}/;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_ssl_server_name on;
    }
}
EOF

echo "$(date '+%Y-%m-%d %H:%M:%S') [frontend] Subindo contêineres frontend..."
sudo docker-compose -f $PROJECT_DIR/docker-compose.yml up -d
sudo chown -R ubuntu:ubuntu $PROJECT_DIR

# ============================================================
# GRAFANA
# ============================================================
echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Criando volume persistente..."
sudo docker volume create grafana-storage

mkdir -p /etc/grafana/provisioning/datasources
cat > /etc/grafana/provisioning/datasources/cloudwatch.yaml << 'EOF_DS'
apiVersion: 1

datasources:
  - name: CloudWatch
    type: cloudwatch
    uid: cloudwatch-brinks
    access: proxy
    isDefault: true
    jsonData:
      authType: default
      defaultRegion: us-east-1
    version: 1
    editable: false

  - name: MySQL
    type: mysql
    uid: mysql-brinks
    url: ${db_host}:3306
    database: db_brink_calcados
    user: grafana
    secureJsonData:
      password: grafana123
    jsonData:
      maxOpenConns: 10
      maxIdleConns: 10
      connMaxLifetime: 14400
    version: 1
    editable: false

EOF_DS

sudo bash -c 'cat > /etc/grafana/provisioning/datasources/testdata.yaml << EOF
apiVersion: 1
datasources:
  - name: TestData
    type: testdata
    uid: grafana-testdata-datasource
    access: proxy
    isDefault: false
    version: 1
    editable: false
EOF'

echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Subindo container Grafana na porta 3000..."
sudo docker run -d \
  --name grafana \
  --restart always \
  -p 3000:3000 \
  -v grafana-storage:/var/lib/grafana \
  -v /etc/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources \
  -e GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS=grafana-testdata-datasource \
  grafana/grafana

echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Aguardando Grafana iniciar..."
until curl -s http://localhost:3000/api/health | grep -q '"database": "ok"'; do
  echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Ainda iniciando, aguardando 5s..."
  sleep 5
done
echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Grafana pronto!"

# ============================================================
# DASHBOARD INFRA (CloudWatch) — formato v2 com elements/layout
# ============================================================
echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Baixando dashboard infra do S3..."
aws s3 cp s3://brinks-grafana-${user_suffix}/brinks-infra.json /tmp/brinks-infra.json

python3 << 'EOF_PY'
import json

with open('/tmp/brinks-infra.json') as f:
    db = json.load(f)

order = [
    item['spec']['element']['name']
    for item in db.get('layout', {}).get('spec', {}).get('items', [])
]

elements = db.get('elements', {})
panels = []
x, y = 0, 0

for name in order:
    element = elements.get(name, {})
    spec = element.get('spec', {})
    viz = spec.get('vizConfig', {}).get('spec', {})
    queries = spec.get('data', {}).get('spec', {}).get('queries', [])

    targets = []
    for q in queries:
        qspec = q.get('spec', {}).get('query', {}).get('spec', {})
        targets.append({
            "refId": q.get('spec', {}).get('refId', 'A'),
            "queryMode": "Metrics",
            "metricQueryType": 0,
            "metricEditorMode": 1,
            "expression": qspec.get('expression', ''),
            "region": "default",
            "datasource": {"type": "cloudwatch", "uid": "cloudwatch-brinks"}
        })

    panel = {
        "id": spec.get('id'),
        "title": spec.get('title', ''),
        "description": spec.get('description', ''),
        "type": spec.get('vizConfig', {}).get('group', 'timeseries'),
        "targets": targets,
        "fieldConfig": viz.get('fieldConfig', {"defaults": {}, "overrides": []}),
        "options": viz.get('options', {}),
        "gridPos": {"h": 8, "w": 12, "x": x, "y": y}
    }
    panels.append(panel)
    x = 12 if x == 0 else 0
    if x == 0:
        y += 8

v1 = {
    "id": None,
    "uid": "brinks-infra",
    "title": db.get('title', 'BrinkCalçados — visão de infraestrutura'),
    "tags": [],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 0,
    "panels": panels,
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "1m"
}

with open('/tmp/payload_infra.json', 'w') as f:
    json.dump({"dashboard": v1, "overwrite": True, "folderId": 0}, f)

print("Infra painéis convertidos:", len(panels))
EOF_PY

RESULT=$(curl -s -X POST http://admin:admin@localhost:3000/api/dashboards/db \
  -H 'Content-Type: application/json' \
  -d @/tmp/payload_infra.json)
echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Infra: $RESULT"

# ============================================================
# DASHBOARD ANALYTICS (MySQL) — formato v1 com panels direto
# ============================================================
echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Baixando dashboard analytics do S3..."
aws s3 cp s3://brinks-grafana-${user_suffix}/brinks-analytics.json /tmp/brinks-analytics.json

python3 << 'EOF_PY2'
import json

with open('/tmp/brinks-analytics.json') as f:
    db = json.load(f)

db['id'] = None
db['version'] = 0

with open('/tmp/payload_analytics.json', 'w') as f:
    json.dump({"dashboard": db, "overwrite": True, "folderId": 0}, f)

print("Analytics painéis:", len(db.get('panels', [])))
EOF_PY2

RESULT=$(curl -s -X POST http://admin:admin@localhost:3000/api/dashboards/db \
  -H 'Content-Type: application/json' \
  -d @/tmp/payload_analytics.json)
echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Analytics: $RESULT"

# ============================================================
# DASHBOARD CSV (Importações Out–Dez 2025) — formato v1 estático gerado por Python
# ============================================================
echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Baixando CSV de importações do S3..."
aws s3 cp s3://brinks-grafana-${user_suffix}/estatisticas_di_2025_10-12_refined.csv /tmp/brinks-importacoes.csv

echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] Gerando dashboard CSV..."
python3 << 'EOF_PY3'
import json
import csv
from collections import defaultdict

NOMES = {
    'CHINA, REPUBLICA POPULAR': 'China',
    'VIETNA': 'Vietnã',
    'INDONESIA': 'Indonésia',
    'ITALIA': 'Itália',
    'CAMBOJA': 'Camboja',
    'PARAGUAI': 'Paraguai',
    'ESPANHA': 'Espanha',
    'PORTUGAL': 'Portugal',
    'INDIA': 'Índia',
}

COLORS = [
    '#E63946','#F4A261','#457B9D','#2A9D8F',
    '#E9C46A','#6D6875','#B5838D','#80B918','#A8DADC'
]

# ── Lê o CSV sem dependência de pandas ──────────────────────
agg = defaultdict(lambda: {
    'preco_vals': [], 'frete_vals': [], 'seguro_vals': [],
    'valor_total': 0.0, 'volume_total': 0.0
})

with open('/tmp/brinks-importacoes.csv', newline='', encoding='utf-8') as f:
    reader = csv.DictReader(f)
    for row in reader:
        pais = row['pais_origem'].strip()
        agg[pais]['preco_vals'].append(float(row['preco_medio']))
        agg[pais]['frete_vals'].append(float(row['frete_medio']))
        agg[pais]['seguro_vals'].append(float(row['seguro_medio']))
        agg[pais]['valor_total']  += float(row['valor_total'])
        agg[pais]['volume_total'] += float(row['volume_total'])

by_country = []
for pais, d in agg.items():
    preco  = sum(d['preco_vals'])  / len(d['preco_vals'])
    frete  = sum(d['frete_vals'])  / len(d['frete_vals'])
    seguro = sum(d['seguro_vals']) / len(d['seguro_vals'])
    by_country.append({
        'pais_label':    NOMES.get(pais, pais),
        'preco_medio':   round(preco, 2),
        'frete_medio':   round(frete, 2),
        'seguro_medio':  round(seguro, 2),
        'custo_chegada': round(preco + frete + seguro, 2),
        'overhead_pct':  round((frete + seguro) / preco * 100, 1) if preco else 0,
        'valor_total':   round(d['valor_total'], 2),
        'volume_total':  round(d['volume_total'], 2),
    })

# ── Helpers ──────────────────────────────────────────────────
def bargauge(pid, title, desc, col, unit, x, y, w=12, h=8):
    rows = sorted(by_country, key=lambda r: r[col], reverse=True)
    targets   = []
    overrides = []
    for i, row in enumerate(rows):
        ref = chr(65 + i)
        targets.append({
            "refId": ref,
            "scenarioId": "manual_entry",
            "alias": row['pais_label'],
            "points": [[row[col], 0]]
        })
        overrides.append({
            "matcher": {"id": "byName", "options": row['pais_label']},
            "properties": [{"id": "color", "value": {
                "fixedColor": COLORS[i % len(COLORS)], "mode": "fixed"
            }}]
        })
    return {
        "id": pid, "title": title, "description": desc,
        "type": "bargauge",
        "datasource": {"type": "testdata", "uid": "grafana-testdata-datasource"},
        "targets": targets,
        "options": {
            "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": False},
            "orientation": "horizontal",
            "displayMode": "gradient",
            "showUnfilled": True,
            "minVizWidth": 10, "minVizHeight": 10,
        },
        "fieldConfig": {
            "defaults": {
                "unit": unit, "min": 0,
                "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": None}]},
                "color": {"mode": "palette-classic"}
            },
            "overrides": overrides
        },
        "gridPos": {"h": h, "w": w, "x": x, "y": y}
    }

def stat(pid, title, desc, value, unit, x, y, w=6, h=4):
    return {
        "id": pid, "title": title, "description": desc,
        "type": "stat",
        "datasource": {"type": "testdata", "uid": "grafana-testdata-datasource"},
        "targets": [{"refId": "A", "scenarioId": "manual_entry",
                     "alias": title, "points": [[round(float(value), 2), 0]]}],
        "options": {
            "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": False},
            "orientation": "auto", "colorMode": "background",
            "graphMode": "none", "justifyMode": "center", "textMode": "auto",
        },
        "fieldConfig": {
            "defaults": {"unit": unit, "color": {"mode": "thresholds"},
                "thresholds": {"mode": "absolute",
                               "steps": [{"color": "blue", "value": None}]}},
            "overrides": []
        },
        "gridPos": {"h": h, "w": w, "x": x, "y": y}
    }

# ── Métricas de topo ─────────────────────────────────────────
total_valor  = sum(r['valor_total']  for r in by_country)
total_volume = sum(r['volume_total'] for r in by_country)
media_preco  = sum(r['preco_medio']  for r in by_country) / len(by_country)
media_frete  = sum(r['frete_medio']  for r in by_country) / len(by_country)

# ── Monta painéis ────────────────────────────────────────────
panels = [
    # Linha 0 — stats
    stat(10, "Valor total importado",  "Out–Dez 2025",                 total_valor,  "currencyUSD",  0,  0),
    stat(11, "Volume total (pares)",   "Out–Dez 2025",                 total_volume, "short",         6,  0),
    stat(12, "Preço FOB médio/par",    "Média entre países",           media_preco,  "currencyUSD", 12,  0),
    stat(13, "Frete médio/embarque",   "Média entre países",           media_frete,  "currencyUSD", 18,  0),

    # Linha 1 — G1 e G2 do notebook
    bargauge(1, "Preço médio FOB por par (US$)",
             "G1 — Qual país vende o calçado mais barato? • Out–Dez 2025",
             'preco_medio', 'currencyUSD', 0, 4),
    bargauge(2, "Frete médio por embarque (US$)",
             "G2 — Qual país tem o frete mais caro? • Out–Dez 2025",
             'frete_medio', 'currencyUSD', 12, 4),

    # Linha 2 — G4 e valor total
    bargauge(3, "Volume total importado (pares)",
             "G4 — Quais países enviam mais calçados? • Out–Dez 2025",
             'volume_total', 'short', 0, 12),
    bargauge(4, "Valor total importado (US$)",
             "Valor FOB total declarado por país • Out–Dez 2025",
             'valor_total', 'currencyUSD', 12, 12),
]

# ── Dashboard final ───────────────────────────────────────────
dashboard = {
    "id": None,
    "uid": "brinks-csv",
    "title": "BrinkCalçados — Importações Out–Dez 2025",
    "tags": ["csv", "importacao"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 0,
    "time": {"from": "now-6h", "to": "now"},
    "refresh": "",
    "panels": panels
}

with open('/tmp/payload_csv.json', 'w', encoding='utf-8') as f:
    json.dump({"dashboard": dashboard, "overwrite": True, "folderId": 0}, f, ensure_ascii=False)

print("CSV painéis gerados:", len(panels))
EOF_PY3

RESULT=$(curl -s -X POST http://admin:admin@localhost:3000/api/dashboards/db \
  -H 'Content-Type: application/json' \
  -d @/tmp/payload_csv.json)
echo "$(date '+%Y-%m-%d %H:%M:%S') [grafana] CSV dashboard: $RESULT"


# ============================================================
# CLOUDWATCH AGENT
# ============================================================
echo "$(date '+%Y-%m-%d %H:%M:%S') [cwagent] Instalando CloudWatch Agent..."
wget -q https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb
dpkg -i -E ./amazon-cloudwatch-agent.deb

CURRENT_HOSTNAME=$(hostname)

sudo tee /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json << EOF
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "$INSTANCE_ID",
      "host": "$CURRENT_HOSTNAME"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": ["cpu_usage_active", "cpu_usage_idle", "cpu_usage_user", "cpu_usage_system"],
        "metrics_collection_interval": 60,
        "totalcpu": true
      },
      "mem": {
        "measurement": ["mem_used_percent", "mem_available", "mem_total"],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": ["used_percent", "free", "total"],
        "metrics_collection_interval": 60,
        "resources": ["/"]
      },
      "diskio": {
        "measurement": ["reads", "writes", "read_bytes", "write_bytes"],
        "metrics_collection_interval": 60,
        "resources": ["*"]
      },
      "net": {
        "measurement": ["bytes_recv", "bytes_sent", "packets_recv", "packets_sent"],
        "metrics_collection_interval": 60,
        "resources": ["eth0"]
      }
    }
  }
}
EOF

sudo /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

systemctl enable amazon-cloudwatch-agent
systemctl start amazon-cloudwatch-agent

echo "$(date '+%Y-%m-%d %H:%M:%S') [cwagent] CloudWatch Agent iniciado"
echo "$(date '+%Y-%m-%d %H:%M:%S') [frontend] Provisionamento concluído"
