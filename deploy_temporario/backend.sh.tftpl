#!/bin/bash
set -euxo pipefail

curl -fsSL https://get.docker.com -o get-docker.sh
sudo sh get-docker.sh
sudo systemctl enable docker
sudo systemctl start docker

mkdir -p /app
cd /app

cat << 'EOF' > docker-compose.yml
version: "3.8"
services:
  backend:
    image: viniciusoliveira201002/backend:latest
    container_name: backend
    ports:
      - "8080:8080"
    environment:
      SPRING_PROFILES_ACTIVE: prod
      JAVA_TOOL_OPTIONS: "-Dfile.encoding=UTF-8"
      SPRING_DATASOURCE_URL: "jdbc:mysql://${db_host}:3306/db_brink_calcados?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true"
      SPRING_DATASOURCE_USERNAME: appuser
      SPRING_DATASOURCE_PASSWORD: app123
      JWT_SECRET: BrinksCalcadosSuperSecretKeyProducao2026Token
      SPRING_RABBITMQ_HOST: ${db_host}
      SPRING_RABBITMQ_PORT: 5672
      SPRING_RABBITMQ_USERNAME: admin
      SPRING_RABBITMQ_PASSWORD: admin
    restart: unless-stopped

  ms-report-async:
    image: viniciusoliveira201002/asyncms:latest
    container_name: ms-report-async
    environment:
      SPRING_RABBITMQ_HOST: ${db_host}
      SPRING_RABBITMQ_PORT: 5672
      SPRING_RABBITMQ_USERNAME: admin
      SPRING_RABBITMQ_PASSWORD: admin
      AWS_REGION: us-east-1
    restart: unless-stopped

  ms-email:
    image: viniciusoliveira201002/inovacao:latest
    container_name: ms-email
    environment:
      SPRING_RABBITMQ_HOST: ${db_host}
      SPRING_RABBITMQ_PORT: 5672
      SPRING_RABBITMQ_USERNAME: admin
      SPRING_RABBITMQ_PASSWORD: admin
    restart: unless-stopped
EOF

sudo docker compose up -d