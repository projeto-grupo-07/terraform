#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

LOG=/var/log/db-deploy.log
exec > >(tee -a "$LOG") 2>&1

echo "$(date '+%Y-%m-%d %H:%M:%S') - Starting DB deployment"
trap 'echo "$(date "+%Y-%m-%d %H:%M:%S") - ERROR at line $LINENO"; exit 1' ERR

# Dependências básicas
echo "$(date '+%Y-%m-%d %H:%M:%S') - Atualizando repositórios APT"
sudo apt-get update -y
echo "$(date '+%Y-%m-%d %H:%M:%S') - Instalando curl e unzip"
sudo apt-get install -y curl unzip

# instala client mysql pra teste
sudo apt-get install -y default-mysql-client

echo "$(date '+%Y-%m-%d %H:%M:%S') - Aplicando upgrades APT"
sudo DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
  -o Dpkg::Options::="--force-confdef" \
  -o Dpkg::Options::="--force-confold"

# Diretórios
echo "$(date '+%Y-%m-%d %H:%M:%S') - Criando diretórios em /app"
sudo mkdir -p /app/sql
sudo chown root:root /app -R
sudo chmod 750 /app

# Instala Docker
if ! command -v docker >/dev/null 2>&1; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - Docker não encontrado — instalando..."
    curl -fsSL https://get.docker.com -o get-docker.sh
    sudo sh get-docker.sh
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - Docker já instalado"
fi

# Sobe Docker
echo "$(date '+%Y-%m-%d %H:%M:%S') - Habilitando e iniciando serviço Docker"
sudo systemctl enable --now docker

# Docker Compose plugin
if ! docker compose version >/dev/null 2>&1; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') - Instalando plugin docker-compose"
    sudo apt-get install -y docker-compose-plugin
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') - Plugin docker compose já presente"
fi

# SQL init
echo "$(date '+%Y-%m-%d %H:%M:%S') - Escrevendo /app/sql/init.sql"
cat << 'EOF_SQL' > /app/sql/init.sql
SET NAMES utf8mb4;
SET CHARACTER SET utf8mb4;
${init_sql_content}
EOF_SQL

sudo chmod 777 /app/sql/init.sql
echo "$(date '+%Y-%m-%d %H:%M:%S') - Permissões definidas em /app/sql/init.sql"

# Compose
echo "$(date '+%Y-%m-%d %H:%M:%S') - Escrevendo /app/docker-compose.yml"
cat << 'EOF_COMPOSE' > /app/docker-compose.yml
${compose_backend}
EOF_COMPOSE

sudo chmod 644 /app/docker-compose.yml
echo "$(date '+%Y-%m-%d %H:%M:%S') - Permissões definidas em /app/docker-compose.yml"

# Retry helper
run_with_retries() {
    local -r cmd="$1"
    local -r attempts=$${2:-5}
    local -r delay=$${3:-5}
    local i=1

    until eval "$cmd"; do
        if [ $i -ge $attempts ]; then
            echo "$(date '+%Y-%m-%d %H:%M:%S') - Command failed after $i attempts: $cmd"
            return 1
        fi

        echo "$(date '+%Y-%m-%d %H:%M:%S') - Command failed (attempt $i). Retrying in $delay seconds..."
        sleep $delay
        i=$((i + 1))
    done
}

# Pull imagens
echo "$(date '+%Y-%m-%d %H:%M:%S') - Pull das imagens"
run_with_retries "sudo docker compose -f /app/docker-compose.yml pull" 5 10

# Sobe stack
echo "$(date '+%Y-%m-%d %H:%M:%S') - Subindo stack com docker compose"
run_with_retries "sudo docker compose -f /app/docker-compose.yml up -d --remove-orphans" 5 10

# Status final
echo "$(date '+%Y-%m-%d %H:%M:%S') - Estado final dos containers"
sudo docker ps -a

# --- Integração do backup ---
echo "$(date '+%Y-%m-%d %H:%M:%S') - Integrando rotina de backup"

# Instala msmtp
export DEBIAN_FRONTEND=noninteractive
echo "postfix postfix/mailname string localhost" | sudo debconf-set-selections
echo "postfix postfix/main_mailer_type string 'Local only'" | sudo debconf-set-selections
echo "msmtp msmtp/apparmor boolean true" | sudo debconf-set-selections
echo "$(date '+%Y-%m-%d %H:%M:%S') - Instalando msmtp"
sudo apt-get install -y msmtp || true

# Instala AWS CLI v2
echo "$(date '+%Y-%m-%d %H:%M:%S') - Instalando AWS CLI v2"
curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -o /tmp/awscliv2.zip -d /tmp
sudo /tmp/aws/install --update

# Cria script de backup
echo "$(date '+%Y-%m-%d %H:%M:%S') - Criando /backup e escrevendo script de backup"
sudo mkdir -p /backup
cat << 'EOF_BACKUP' > /backup/backup.sh
${backup_script}
EOF_BACKUP
sudo chmod +x /backup/backup.sh

# Credenciais AWS para root (cron roda como root)
echo "$(date '+%Y-%m-%d %H:%M:%S') - Criando credenciais AWS para root"
sudo mkdir -p /root/.aws
cat << EOF > /root/.aws/credentials
[default]
aws_access_key_id=${aws_access_key}
aws_secret_access_key=${aws_secret_key}
aws_session_token=${aws_session_token}
EOF
cat << EOF > /root/.aws/config
[default]
region=us-east-1
output=json
EOF
sudo chmod 600 /root/.aws/credentials /root/.aws/config

# msmtprc para root (cron roda como root)
echo "$(date '+%Y-%m-%d %H:%M:%S') - Criando /root/.msmtprc"
cat << EOF > /root/.msmtprc
defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt

account gmail
host smtp.gmail.com
port 587
from ${gmail_user}
user ${gmail_user}
password ${gmail_password}

account default : gmail
EOF
sudo chmod 600 /root/.msmtprc

# Inicia cron
echo "$(date '+%Y-%m-%d %H:%M:%S') - Escrevendo cron e iniciando"
cat << 'EOF_CRON' > /tmp/cron.sh
${cron_script}
EOF_CRON
sudo chmod +x /tmp/cron.sh
nohup bash /tmp/cron.sh > /tmp/cron-init.log 2>&1 &

echo "$(date '+%Y-%m-%d %H:%M:%S') - DB deployment finished"